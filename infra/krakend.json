{
  "version": 3,
  "name": "Anime API Gateway",
  "port": 8080,
  "extra_config": {
    "github_com/devopsfaith/krakend-jose": {
      "alg": "HS256",
      "secret": "anime-platform-dev-secret-12345"
    }
  },
  "endpoints": [
    {
      "endpoint": "/auth/login",
      "method": "POST",
      "backend": [{ "url_pattern": "/login", "host": ["http://auth-service:8080"] }]
    },
    {
      "endpoint": "/auth/refresh",
      "method": "POST",
      "backend": [{ "url_pattern": "/refresh", "host": ["http://auth-service:8080"] }]
    },
    {
      "endpoint": "/catalog/{id}",
      "method": "GET",
      "extra_config": {
        "github_com/devopsfaith/krakend-jose/validator": {
          "alg": "HS256",
          "audience": ["anime-platform"]
        }
      },
      "backend": [{ "url_pattern": "/anime/{id}", "host": ["http://catalog-service:8080"] }]
    }
  ]
}